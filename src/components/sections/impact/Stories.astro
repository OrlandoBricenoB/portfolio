---
import StoriesPin from '../../islands/StoriesPin.jsx'
import { useTranslations } from '../../../i18n/utils'
import type { Lang } from '../../../i18n/config'

import destroyedBuildings from '../../../assets/images/stories/destroyed-buildings.jpg'
import destroyedBuildingsWebp from '../../../assets/images/stories/destroyed-buildings.webp'
import bringingLoveToKids from '../../../assets/images/stories/bringing-love-to-kids.jpg'
import bringingLoveToKidsWebp from '../../../assets/images/stories/bringing-love-to-kids.webp'
import wck from '../../../assets/images/stories/wck.jpg'
import wckWebp from '../../../assets/images/stories/wck.webp'
import barber from '../../../assets/images/stories/barber.jpg'
import barberWebp from '../../../assets/images/stories/barber.webp'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const items = [
  { id: 'zone', image: destroyedBuildings, webp: destroyedBuildingsWebp, fit: 'cover', position: 'center' },
  { id: 'kids', image: bringingLoveToKids, webp: bringingLoveToKidsWebp, fit: 'contain', position: 'center' },
  { id: 'wck', image: wck, webp: wckWebp, fit: 'cover', position: 'center 15%' },
  { id: 'barber', image: barber, webp: barberWebp, fit: 'cover', position: 'center' },
]

const stories = items.map(({ id, image, webp, fit, position }) => ({
  id,
  image: image.src,
  imageWebp: webp.src,
  fit,
  position,
  title: t(`stories--${id}-title`),
  body: t(`stories--${id}-body`),
  alt: t(`stories--${id}-alt`),
}))
---
<section class="stories" id="stories">
  <StoriesPin
    client:visible
    kicker={t('stories--kicker')}
    title={t('stories--title')}
    intro={t('stories--intro')}
    hint={t('stories--hint')}
    stories={stories}
  />
</section>

<style is:global>
  /* Island markup is not scoped by Astro, so these rules are global and namespaced with .stories__ */
  .stories { background-color: var(--color-ink); color: #fff; }
  .stories__pin { height: 100svh; display: flex; flex-direction: column; padding: 5.25rem 0 1.15rem; }
  .stories__layout { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .stories__kicker { margin: 0; color: var(--color-blue-400); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.85rem; }
  .stories__title { margin: 0.35rem 0 0; font-size: clamp(1.7rem, 2.4vw, 2.35rem); max-width: 22ch; font-weight: 900; letter-spacing: -0.03em; line-height: 1.08; }
  .stories__intro { max-width: 46rem; color: #d6d9fd; font-size: 1.02rem; line-height: 1.5; margin: 0.45rem 0 0; }
  .stories__header { flex: 0 0 auto; margin-bottom: 1rem; }
  .stories__stage { position: relative; flex: 1; min-height: 0; }
  .stories__chapter {
    position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.25rem, 3vw, 2.75rem); align-items: stretch; pointer-events: none;
  }
  .stories__chapter.is-active { pointer-events: auto; }
  .stories__chapter:not(:first-child) .stories__frame,
  .stories__chapter:not(:first-child) .stories__panel { opacity: 0; visibility: hidden; }
  .stories__frame { position: relative; min-height: 0; border-radius: 1rem; overflow: hidden; background: var(--color-blue-950); }
  .stories__photo { position: absolute; inset: 0; }
  .stories__photo picture, .stories__photo img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stories__panel { display: flex; flex-direction: column; justify-content: center; min-height: 0; overflow: auto; padding-right: 0.25rem; }
  .stories__index { margin: 0 0 0.65rem; color: var(--color-blue-400); letter-spacing: 0.14em; font-size: 0.78rem; }
  .stories__index span { color: rgba(255, 255, 255, 0.45); }
  .stories__card_title { margin: 0 0 0.65rem; font-size: clamp(1.35rem, 2vw, 1.85rem); font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; }
  .stories__panel p:not(.stories__index) { color: #e7e9ff; font-size: 1.05rem; line-height: 1.6; margin: 0; }
  .stories__progress { flex: 0 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0.55rem 1rem; margin-top: 0.9rem; }
  .stories__track { grid-column: 1 / -1; height: 3px; border-radius: 999px; background: rgba(255, 255, 255, 0.16); overflow: hidden; }
  .stories__track span { display: block; height: 100%; width: 100%; transform: scaleX(var(--stories-progress, 0)); transform-origin: left center; background: var(--color-blue-400); }
  .stories__dots { display: flex; align-items: center; gap: 0.4rem; }
  .stories__dot { position: relative; width: 1.65rem; height: 1.35rem; padding: 0; border: 0; border-radius: 999px; background: transparent; cursor: pointer; }
  .stories__dot::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 3px; border-radius: 999px; background: rgba(255, 255, 255, 0.28); transform: translateY(-50%); }
  .stories__dot.is-active::before, .stories__dot[aria-current="true"]::before { background: var(--color-blue-400); }
  .stories__dot.is-next::before { background: var(--color-blue-400); opacity: 0.45; animation: stories-next 0.9s ease-in-out infinite; }
  @keyframes stories-next { 50% { opacity: 1; transform: translateY(-50%) scaleX(1.15); } }
  .stories__hint { margin: 0; color: rgba(255, 255, 255, 0.62); font-size: 0.85rem; letter-spacing: 0.02em; max-width: 28ch; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stories__hint.is-next { color: var(--color-blue-400); }
  .stories__hint.is-done { opacity: 0; }

  @media (width <= 800px) {
    .stories__pin { padding-top: 4.25rem; padding-bottom: 0.65rem; }
    .stories__header { margin-bottom: 0.55rem; }
    .stories__title { font-size: 1.45rem; }
    .stories__intro { font-size: 0.88rem; line-height: 1.35; margin-top: 0.3rem; }
    .stories__chapter { grid-template-columns: 1fr; grid-template-rows: minmax(6.5rem, 22svh) minmax(0, 1fr); gap: 0.65rem; }
    .stories__panel { justify-content: flex-start; overflow: visible; padding-right: 0; }
    .stories__index { margin-bottom: 0.3rem; }
    .stories__card_title { font-size: 1.2rem; margin-bottom: 0.35rem; }
    .stories__panel p:not(.stories__index) { font-size: 0.92rem; line-height: 1.4; }
    .stories__hint { display: none; }
  }
</style>
