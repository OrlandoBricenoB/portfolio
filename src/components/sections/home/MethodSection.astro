---
import SectionHeader from '../../atoms/SectionHeader.astro'
import Heading from '../../atoms/Heading.astro'
import { useTranslations } from '../../../i18n/utils'
import type { Lang } from '../../../i18n/config'

const { lang } = Astro.props as { lang: Lang }
const t = useTranslations(lang)
const steps = ['1', '2', '3', '4']
---
<section class="section section--dark relative pb-12" id="method">
  <div class="wrapper">
    <SectionHeader note={t('method--kicker')} title={t('method--title')} intro={t('method--intro')} />
    <div class="relative grid grid-cols-4 gap-4 max-[1100px]:grid-cols-2 max-[560px]:grid-cols-1" data-reveal-stagger>
      <div
        class="pointer-events-none absolute top-[2.65rem] right-[2%] left-[2%] h-0.5 origin-left bg-white/12 max-[1100px]:hidden [&>span]:block [&>span]:h-full [&>span]:origin-left [&>span]:bg-blue-400 [&>span]:[transform:scaleX(var(--p,1))]"
        data-method-line
        aria-hidden="true"
      ><span></span></div>
      {steps.map(step => (
        <article class="relative z-[1] flex flex-col rounded-[18px] border border-white/12 bg-white/6 px-[1.4rem] pt-6 pb-[1.6rem] transition duration-200 hover:-translate-y-[3px] hover:border-blue-400 hover:bg-white/9" data-reveal="up">
          <span class="inline-grid h-[46px] min-w-[46px] w-fit -rotate-[8deg] place-items-center rounded-[14px] bg-blue-700 px-2.5 text-[1.1rem] font-black text-white">0{step}</span>
          <Heading as="h3" class="mt-[.9rem]! mb-[.6rem]!">{t(`method--${step}-title`)}</Heading>
          <p class="m-0 text-[.95rem] leading-[1.55] opacity-[.82]">{t(`method--${step}-body`)}</p>
        </article>
      ))}
    </div>
  </div>
</section>
