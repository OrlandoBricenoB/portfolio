---
import '../styles/global.css'
import type { Lang } from '../i18n/config'

interface Props {
  lang: Lang
  title?: string
  description?: string
  type?: 'website' | 'article'
  published?: Date
  modified?: Date
  // Absolute URL for og:image / twitter:image; defaults to the site card.
  image?: string
  // Overrides the default same-path hreflang pairs (e.g. blog posts that exist in one language only).
  alternates?: Partial<Record<Lang, string>>
}
const {
  lang,
  title = 'Orlando Briceño | Gadmin Founder',
  type = 'website',
  published,
  modified,
  image,
  alternates,
  description = '¡Hola! Soy Orlando Briceño, fundador de Gadmin y emprendedor. Quiero ayudar a las personas, es por eso que creé las herramientas de Gadmin.',
} = Astro.props
const site = 'https://orlandobricenob.com'
const ogImage = image ?? `${site}/og-meta.png`
const url = new URL(Astro.url.pathname, site).href
const basePath = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/'
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#050528" />
    <meta name="theme-color" content="#0051ff" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gochi+Hand&family=Inter:wght@400;500;600;700;900&display=swap" />

    <link rel="canonical" href={url} />
    {alternates ? (
      Object.entries(alternates).map(([code, path]) => <link rel="alternate" hreflang={code} href={new URL(path, site).href} />)
    ) : (
      <>
        <link rel="alternate" hreflang="en" href={new URL(basePath, site).href} />
        <link rel="alternate" hreflang="es" href={new URL(`/es${basePath}`, site).href} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="Orlando Briceño" href={lang === 'es' ? '/es/rss.xml' : '/rss.xml'} />
    <slot name="head" />

    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <script is:inline async src="https://cdn.seline.so/seline.js" data-token="4e832700dab5473"></script>
  </head>
  <body>
    <slot name="header" />
    <slot />
    <slot name="footer" />
    <div class="site-scroll" aria-hidden="true"><span></span></div>
    <script>
      import '../scripts/site-motion'
    </script>
  </body>
</html>
