---
import { render } from 'astro:content'
import { Image } from 'astro:assets'
import PageLayout from '../layouts/PageLayout.astro'
import Button from '../components/atoms/Button.astro'
import Email from '../components/icons/Email.jsx'
import { formatDate, postSlug, readingMinutes, type Post } from '../i18n/blog'
import { localizePath, useTranslations } from '../i18n/utils'
import type { Lang } from '../i18n/config'

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props
const t = useTranslations(lang)
const { Content } = await render(post)
const { title, description, date, updated, tags, translation, cover } = post.data

const other: Lang = lang === 'en' ? 'es' : 'en'
const selfPath = localizePath(`/blog/${postSlug(post)}/`, lang)
const otherPath = translation ? localizePath(`/blog/${translation}/`, other) : undefined
const alternates = { [lang]: selfPath, ...(otherPath && { [other]: otherPath }) }

const site = 'https://orlandobricenob.com'
const ogImage = cover ? new URL(cover.src, site).href : `${site}/og-meta.png`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: lang,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  keywords: tags.join(', '),
  mainEntityOfPage: new URL(selfPath, site).href,
  author: { '@type': 'Person', name: 'Orlando Briceño', url: site },
  image: ogImage,
}
---
<PageLayout lang={lang} title={`${title} | Orlando Briceño`} description={description} type="article" published={date} modified={updated} image={ogImage} alternates={alternates}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main>
    <section class="bg-[radial-gradient(900px_420px_at_85%_-10%,rgba(0,81,255,0.3),transparent_60%)] bg-ink pt-36 pb-14 text-white max-[640px]:pt-28">
      <div class="wrapper max-w-[46rem]!">
        <a class="text-sm font-semibold text-blue-300 no-underline hover:underline" href={localizePath('/blog', lang)}>← {t('blog--back')}</a>
        <h1 class="mt-4 text-[clamp(2rem,4.5vw,3rem)] font-black leading-[1.15]">{title}</h1>
        <p class="mt-3 text-sm text-white/70">
          <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
          {updated && <> · {t('blog--updated')} <time datetime={updated.toISOString()}>{formatDate(updated, lang)}</time></>}
          · {readingMinutes(post.body)} {t('blog--min-read')}
        </p>
        {tags.length > 0 && (
          <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
            {tags.map(tag => <li class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold">{tag}</li>)}
          </ul>
        )}
        {otherPath && <p class="mt-3 text-sm"><a class="text-blue-300" href={otherPath} hreflang={other}>{t('blog--read-in-other')}</a></p>}
      </div>
    </section>

    <article class="bg-white pt-14 pb-16">
      <div class="wrapper max-w-[46rem]!">
        {cover && <Image class="mb-10 w-full rounded-[22px]" src={cover} alt="" width={1200} height={630} widths={[640, 1200]} sizes="(max-width: 46rem) 100vw, 46rem" loading="eager" />}
        <div class="prose-post"><Content /></div>

        <aside class="mt-14 rounded-[22px] bg-ink p-8 text-white">
          <h2 class="text-2xl font-extrabold">{t('blog--cta-title')}</h2>
          <p class="mt-2 text-white/85">{t('blog--cta-body')}</p>
          <div class="mt-5">
            <Button href="mailto:orlando@gadmin.app">
              <Email slot="icon" size="24" color="#ffffff" />
              {t('common--cta-email')}
            </Button>
          </div>
        </aside>
      </div>
    </article>
  </main>
</PageLayout>
