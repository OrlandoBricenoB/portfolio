---
import PageLayout from '../layouts/PageLayout.astro'
import Button from '../components/atoms/Button.astro'
import Heading from '../components/atoms/Heading.astro'
import Email from '../components/icons/Email.jsx'
import Stories from '../components/sections/impact/Stories.astro'
import Recognitions from '../components/sections/impact/Recognitions.astro'
import { localizePath, useTranslations } from '../i18n/utils'
import type { Lang } from '../i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const lead = 'mt-4 max-w-[44rem] text-[1.2rem] leading-[1.55] text-white/85'
const ghost = 'inline-flex min-h-11 items-center rounded-full px-[22px] py-3 font-bold text-white no-underline shadow-[inset_0_0_0_2px_rgba(255,255,255,0.35)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[inset_0_0_0_2px_var(--color-blue-400)]'
---
<PageLayout lang={lang} title={t('impact--meta-title')} description={t('impact--meta-description')}>
  <main>
    <section class="bg-[radial-gradient(900px_420px_at_85%_-10%,rgba(0,81,255,0.3),transparent_60%)] bg-ink pt-36 pb-20 text-white max-[640px]:pt-28">
      <div class="wrapper">
        <p class="mb-2 inline-block -rotate-2 font-hand text-[24px] text-blue-300 before:text-blue-400 before:content-['→_']">{t('impact--kicker')}</p>
        <Heading as="h1" text={t('impact--title')} class="m-0! max-w-[46rem] text-[clamp(2.4rem,5vw,3.8rem)]! leading-[1.12]!" />
        <p class={lead}>{t('impact--lead')}</p>
      </div>
    </section>

    <Stories lang={lang} />
    <Recognitions lang={lang} />

    <section class="bg-ink pt-20 pb-24 text-white">
      <div class="wrapper">
        <Heading as="h2" text={t('impact--closing-title')} class="max-w-[40rem]" />
        <p class={lead}>{t('impact--closing-body')}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="mailto:orlando@gadmin.app">
            <Email slot="icon" size="24" color="#ffffff" />
            {t('common--cta-email')}
          </Button>
          <a class={ghost} href={localizePath('/', lang)}>{t('impact--cta-home')}</a>
          <a class={ghost} href={localizePath('/courses', lang)}>{t('impact--cta-courses')}</a>
        </div>
      </div>
    </section>
  </main>
</PageLayout>
